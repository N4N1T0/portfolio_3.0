		"node": ">=22.22.0"
	},
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"astro": "astro",
		"check": "npm run check:types && npm run check:astro && npm run check:lint && npm run check:format",
		"check:types": "tsc --noEmit",
		"check:astro": "astro check",
		"check:lint": "eslint .",
		"check:lint:fix": "eslint . --fix",
