		"check:format:fix": "prettier --write .",
		"check:dead": "fallow dead-code",
		"check:dupes": "fallow dupes",
		"check:health": "fallow health",
		"check:all": "npm run check && npm run check:dead && npm run check:dupes && npm run check:health",
		"hooks:install": "lefthook install",
		"prepare": "lefthook install || exit 0"
	},
	"dependencies": {
