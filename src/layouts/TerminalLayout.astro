---
import '@fontsource/geist-pixel/latin-400.css';
import '@fontsource/geist-mono/latin-400.css';
import '@fontsource/geist-mono/latin-500.css';
import '../styles/global.css';
import { getRelativeLocaleUrl } from 'astro:i18n';
import SeoHead from '@/components/SeoHead.astro';
import ShellPrompt from '@/components/ShellPrompt.tsx';
import TerminalFooter from '@/components/TerminalFooter.astro';
import TerminalHeader from '@/components/TerminalHeader.astro';
import { copy } from '@/data/copy';
import { buildCommands, buildNav } from '@/lib/nav';

interface Props {
	locale: 'en' | 'es';
	title: string;
	description: string;
	ogAlt: string;
}

const { locale, title, description, ogAlt } = Astro.props;
const t = copy[locale];
const altLocale = locale === 'en' ? 'es' : 'en';

const nav = buildNav(locale);
const commands = buildCommands(locale);
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<!doctype html>
<html lang={locale}>
	<head>
		<SeoHead locale={locale} title={title} description={description} ogAlt={ogAlt} />
		<script is:inline>
			// the terminal boots once per session: hide the loader before it paints
			try {
				if (sessionStorage.getItem('terminal:booted')) {
					document.documentElement.dataset.booted = 'true';
				}
			} catch {
				// private mode: the boot plays again
			}
		</script>
	</head>
	<body class="relative flex min-h-dvh flex-col overflow-x-hidden bg-ground pb-[4.75rem] pt-9 font-mono text-phosphor antialiased">
		<div
			class="crt-scanlines pointer-events-none fixed inset-0 z-30 opacity-30"
			aria-hidden="true"
		></div>
		<div class="crt-vignette pointer-events-none fixed inset-0 z-30" aria-hidden="true"></div>

		<TerminalHeader locale={locale} />

		<main id="main" class="relative z-10 flex-1">
			<slot />
		</main>

		<ShellPrompt
			client:load
			commands={commands}
			altLocale={{ label: altLocale, href: getRelativeLocaleUrl(altLocale) }}
			language={t.language}
			prompt={t.prompt}
			a11y={{ output: t.a11y.output }}
			locale={locale}
			homePath={getRelativeLocaleUrl(locale)}
			currentPath={currentPath}
		/>

		<TerminalFooter locale={locale} nav={nav} currentPath={currentPath} />
	</body>
</html>
