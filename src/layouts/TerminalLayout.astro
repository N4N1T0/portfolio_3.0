---
import '@fontsource/geist-pixel/latin-400.css';
import '@fontsource/geist-mono/latin-400.css';
import '@fontsource/geist-mono/latin-500.css';
import '../styles/global.css';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { copy } from '@/data/copy';
import { type SeoProps } from '@/lib/seo';
import SeoHead from '@/components/SeoHead.astro';
import TerminalBoot from '@/components/TerminalBoot.islas.tsx';
import TerminalFooter from '@/components/TerminalFooter.astro';
import TerminalHeader from '@/components/TerminalHeader.astro';
import { buildCommands, buildNav } from '@/lib/nav';

type Props = SeoProps;

const {
	locale,
	title,
	description,
	ogAlt,
	alternateHref,
	alternateLang,
	breadcrumbs,
	blogPosting,
} = Astro.props;
const altLocale = locale === 'en' ? 'es' : 'en';
const t = copy[locale];

const nav = buildNav(locale);
const commands = buildCommands(locale);
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
// home already runs its own boot sequence inside Terminal: the layout only
// boots the other pages when they are entered directly for the first time.
const isHome = currentPath === `/${locale}`;
---

<!doctype html>
<html lang={locale}>
	<head>
		<SeoHead
			locale={locale}
			title={title}
			description={description}
			ogAlt={ogAlt}
			alternateHref={alternateHref}
			alternateLang={alternateLang}
			breadcrumbs={breadcrumbs}
			blogPosting={blogPosting}
		/>
		<script is:inline>
			// the terminal boots once per session: hide the page shell before it paints
			// and reveal it when the loader sequence finishes (terminal:ready).
			(function () {
				const html = document.documentElement;
				const shell = document.getElementById('shell');
				if (sessionStorage.getItem('terminal:booted')) {
					html.dataset.booted = 'true';
					if (shell) shell.style.opacity = '1';
					return;
				}
				html.dataset.booting = 'true';
				if (shell) shell.style.opacity = '0';
				window.addEventListener(
					'terminal:ready',
					function () {
						html.dataset.booted = 'true';
						delete html.dataset.booting;
						if (shell) shell.style.opacity = '1';
					},
					{ once: true },
				);
			})();
		</script>
	</head>
	<body class="relative flex min-h-dvh flex-col overflow-x-hidden bg-ground pb-[4.75rem] pt-9 font-mono text-phosphor antialiased">
		<div
			class="crt-scanlines pointer-events-none fixed inset-0 z-30 opacity-30"
			aria-hidden="true"
		></div>
		<div class="crt-vignette pointer-events-none fixed inset-0 z-30" aria-hidden="true"></div>

		<TerminalHeader locale={locale} />

		<div id="shell" class="relative z-10">
			<main id="main" class="flex-1">
				<slot />
			</main>

			<TerminalFooter
				locale={locale}
				nav={nav}
				commands={commands}
				altLocale={{ label: altLocale, href: getRelativeLocaleUrl(altLocale) }}
				homePath={getRelativeLocaleUrl(locale)}
				currentPath={currentPath}
			/>
		</div>

		{!isHome && <TerminalBoot client:load boot={t.boot} a11yLabel={t.a11y.loader} />}
	</body>
</html>
