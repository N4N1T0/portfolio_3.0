---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { profile } from '@/data/profile';

interface Props {
	locale: 'en' | 'es';
}

const { locale } = Astro.props;
---

<header class="fixed inset-x-0 top-0 z-20 flex h-9 items-center justify-between gap-4 border-b border-edge bg-ground px-4 font-mono text-xs text-phosphor-dim">
	<a
		href={getRelativeLocaleUrl(locale)}
		class="font-display text-phosphor-bright transition-colors hover:text-accent"
		aria-label={profile.name}
	>
		{profile.initials}
	</a>
	<span class="hidden sm:inline">PORTFOLIO TERMINAL v3.0</span>
	<time data-clock data-locale={locale} class="tabular-nums">
		--:--:--
	</time>
</header>

<script>
	const clock = document.querySelector<HTMLElement>('[data-clock]');
	if (clock) {
		const locale = clock.dataset.locale === 'es' ? 'es-ES' : 'en-GB';
		const tick = () => {
			clock.textContent = new Date().toLocaleTimeString(locale, { hour12: false });
		};
		tick();
		setInterval(tick, 1000);
	}
</script>
