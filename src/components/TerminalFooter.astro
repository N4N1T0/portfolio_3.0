---
import { copy } from '@/data/copy';

interface Props {
	locale: 'en' | 'es';
}

const { locale } = Astro.props;
const t = copy[locale];
const buildDate = new Date().toLocaleDateString(locale === 'en' ? 'en-GB' : 'es-ES', {
	year: 'numeric',
	month: '2-digit',
	day: '2-digit',
});
---

<footer class="fixed inset-x-0 bottom-0 z-20 flex h-8 items-center justify-between gap-4 border-t border-edge bg-ground px-4 font-mono text-xs text-phosphor-dim">
	<span>{t.footer.copyright}</span>
	<span class="hidden sm:inline">
		{t.footer.stack} · {t.footer.license}
	</span>
	<span class="tabular-nums">
		{t.footer.build} {buildDate}
	</span>
</footer>
