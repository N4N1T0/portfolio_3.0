---
import ShellPrompt from '@/components/ShellPrompt.tsx';
import { copy, type Locale } from '@/data/copy';
import type { NavItem } from '@/lib/nav';

interface Props {
	locale: Locale;
	nav: NavItem[];
	commands: import('@/data/commands').Command[];
	altLocale: { label: string; href: string };
	homePath: string;
	currentPath: string;
}

const { locale, nav, commands, altLocale, homePath, currentPath } = Astro.props;
const t = copy[locale];
const buildDate = new Date().toLocaleDateString(locale === 'en' ? 'en-GB' : 'es-ES', {
	year: 'numeric',
	month: '2-digit',
	day: '2-digit',
});
---

<footer class="fixed inset-x-0 bottom-0 z-20 border-t border-edge bg-ground px-4 font-mono text-xs text-phosphor-dim">
	<ShellPrompt
		client:load
		commands={commands}
		nav={nav}
		altLocale={altLocale}
		prompt={t.prompt}
		help={t.help}
		a11y={{ output: t.a11y.output }}
		locale={locale}
		homePath={homePath}
		currentPath={currentPath}
		buildDate={buildDate}
	/>
</footer>
