---
import { profile } from '@/data/profile';
import { type SeoProps } from '@/lib/seo';
import SocialMeta from '@/components/SocialMeta.astro';

type Props = SeoProps;

const { locale, title, description, ogAlt } = Astro.props;
const { alternateHref, alternateLang, breadcrumbs, blogPosting } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const alternateAbsolute = alternateHref ? new URL(alternateHref, Astro.site).href : undefined;
const alternateEn = new URL('/en/', Astro.site).href;
// x-default points at the English version of this page, not always at the home
const defaultHref = locale === 'en' ? canonical : (alternateAbsolute ?? alternateEn);
const ogImage = new URL(locale === 'en' ? '/og.png' : '/og-es.png', Astro.site).href;

const jsonLd = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'WebSite',
			'@id': `${Astro.site}#website`,
			url: canonical,
			name: 'Adrian Alvarez Portfolio',
			description,
			inLanguage: locale,
		},
		{
			'@type': 'Person',
			'@id': `${Astro.site}#person`,
			name: profile.name,
			url: canonical,
			jobTitle: profile.role,
			email: `mailto:${profile.email}`,
			telephone: profile.phone,
			homeLocation: { '@type': 'Place', name: profile.location },
			sameAs: profile.socials.map((social) => social.url),
		},
		...(blogPosting
			? [
					{
						'@type': 'BlogPosting',
						'@id': `${canonical}#blogpost`,
						url: blogPosting.url,
						headline: blogPosting.title,
						description: blogPosting.description,
						datePublished: blogPosting.datePublished,
						...(blogPosting.dateModified && {
							dateModified: blogPosting.dateModified,
						}),
						author: {
							'@type': 'Person',
							name: blogPosting.author,
						},
						publisher: {
							'@type': 'Organization',
							name: 'Adrian Alvarez',
							url: Astro.site,
						},
						...(blogPosting.image && { image: blogPosting.image }),
						mainEntityOfPage: {
							'@type': 'WebPage',
							'@id': canonical,
						},
					},
				]
			: []),
		...(breadcrumbs
			? [
					{
						'@type': 'BreadcrumbList',
						itemListElement: breadcrumbs.map((crumb, index) => ({
							'@type': 'ListItem',
							position: index + 1,
							name: crumb.name,
							item: new URL(crumb.href, Astro.site).href,
						})),
					},
				]
			: []),
	],
};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content="index, follow" />
<link rel="canonical" href={canonical} />
<link rel="alternate" hreflang={locale} href={canonical} />
{alternateAbsolute && alternateLang && (
	<link rel="alternate" hreflang={alternateLang} href={alternateAbsolute} />
)}
<link rel="alternate" hreflang="x-default" href={defaultHref} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

<SocialMeta
	locale={locale}
	title={title}
	description={description}
	ogAlt={ogAlt}
	canonical={canonical}
	ogImage={ogImage}
/>

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
