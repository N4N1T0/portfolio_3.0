---
import { profile } from '@/data/profile';
import { USER_DATA } from '@/data/site-data';
import { feedPath } from '@/lib/rss';
import { type SeoProps } from '@/lib/seo';
import BrandIcons from '@/components/BrandIcons.astro';
import SocialMeta from '@/components/SocialMeta.astro';

type Props = SeoProps;

const { locale, title, description, ogAlt } = Astro.props;
const {
	alternateHref,
	alternateLang,
	breadcrumbs,
	blogPosting,
	project,
	codeSnippet,
	collectionPage,
	noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const alternateAbsolute = alternateHref ? new URL(alternateHref, Astro.site).href : undefined;
const alternateEn = new URL('/en/', Astro.site).href;
// x-default points at the English version of this page, not always at the home
const defaultHref = locale === 'en' ? canonical : (alternateAbsolute ?? alternateEn);
const ogImage = new URL(locale === 'en' ? '/og.png' : '/og-es.png', Astro.site).href;

const personId = `${Astro.site}#person`;
const organizationId = `${Astro.site}#organization`;
// sameAs only takes public profiles, the email has its own property
const organizationProfiles = profile.socials.filter(
	({ id }) => id === 'github' || id === 'linkedin',
);

const jsonLd = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'WebSite',
			'@id': `${Astro.site}#website`,
			url: canonical,
			name: 'Adrian Alvarez Portfolio',
			description,
			inLanguage: locale,
		},
		{
			'@type': 'Person',
			'@id': personId,
			name: profile.name,
			url: canonical,
			jobTitle: profile.role,
			email: `mailto:${profile.email}`,
			telephone: profile.phone,
			homeLocation: { '@type': 'Place', name: profile.location },
			sameAs: profile.socials.map((social) => social.url),
		},
		{
			'@type': 'Organization',
			'@id': organizationId,
			name: USER_DATA.displayName,
			url: Astro.site,
			logo: new URL('/icon-512.png', Astro.site).href,
			email: profile.email,
			founder: { '@id': personId },
			sameAs: organizationProfiles.map((social) => social.url),
		},
		...(blogPosting
			? [
					{
						'@type': 'BlogPosting',
						'@id': `${canonical}#blogpost`,
						url: blogPosting.url,
						headline: blogPosting.title,
						description: blogPosting.description,
						datePublished: blogPosting.datePublished,
						...(blogPosting.dateModified && {
							dateModified: blogPosting.dateModified,
						}),
						author: {
							'@type': 'Person',
							name: blogPosting.author,
						},
						publisher: { '@id': organizationId },
						...(blogPosting.image && { image: blogPosting.image }),
						mainEntityOfPage: {
							'@type': 'WebPage',
							'@id': canonical,
						},
					},
				]
			: []),
		...(project
			? [
					{
						'@type': 'Project',
						'@id': `${canonical}#project`,
						url: project.url,
						name: project.name,
						description: project.description,
						...(project.image && { image: project.image }),
						dateCreated: project.dateCreated,
						author: {
							'@type': 'Person',
							name: 'Adrián Álvarez',
						},
						publisher: { '@id': organizationId },
					},
				]
			: []),
		...(codeSnippet
			? [
					{
						'@type': 'Code',
						'@id': `${canonical}#snippet`,
						url: codeSnippet.url,
						name: codeSnippet.title,
						description: codeSnippet.description,
						programmingLanguage: codeSnippet.programmingLanguage,
						...(codeSnippet.dateCreated && { dateCreated: codeSnippet.dateCreated }),
						author: {
							'@type': 'Person',
							name: codeSnippet.author,
						},
						publisher: { '@id': organizationId },
					},
				]
			: []),
		...(collectionPage
			? [
					{
						'@type': 'CollectionPage',
						'@id': `${canonical}#collection`,
						url: collectionPage.url,
						name: collectionPage.title,
						description: collectionPage.description,
					},
				]
			: []),
		...(breadcrumbs
			? [
					{
						'@type': 'BreadcrumbList',
						itemListElement: breadcrumbs.map((crumb, index) => ({
							'@type': 'ListItem',
							position: index + 1,
							name: crumb.name,
							item: new URL(crumb.href, Astro.site).href,
						})),
					},
				]
			: []),
	],
};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
{!noindex && (
	<>
		<link rel="canonical" href={canonical} />
		<link rel="alternate" hreflang={locale} href={canonical} />
		{alternateAbsolute && alternateLang && (
			<link rel="alternate" hreflang={alternateLang} href={alternateAbsolute} />
		)}
		<link rel="alternate" hreflang="x-default" href={defaultHref} />
	</>
)}
<link rel="alternate" type="application/rss+xml" title="RSS" href={feedPath(locale)} />
<BrandIcons />

<SocialMeta
	locale={locale}
	title={title}
	description={description}
	ogAlt={ogAlt}
	canonical={canonical}
	ogImage={ogImage}
/>

{!noindex && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
