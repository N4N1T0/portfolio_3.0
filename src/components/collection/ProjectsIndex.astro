---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { copy, type Locale } from '@/data/copy';
import { getProjects } from '@/lib/content';
import CollectionIndex from '@/components/collection/CollectionIndex.astro';
import { type Row } from '@/components/collection/EntryList.astro';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = copy[locale];
const projects = await getProjects(locale);

const rows: Row[] = projects.map((project) => ({
	label: project.data.title,
	meta: project.data.excerpt,
	href: getRelativeLocaleUrl(locale, `projects/${project.id}`),
}));
---

<CollectionIndex
	locale={locale}
	path="projects"
	titleKey="projectsTitle"
	subtitleKey="projectsSubtitle"
	length={projects.length}
	rows={rows}
	note={t.collections.projectsNote}
/>
