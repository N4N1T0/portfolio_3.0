---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { type Locale } from '@/data/copy';
import { getSnippets } from '@/lib/content';
import CollectionIndex from '@/components/collection/CollectionIndex.astro';
import { type Row } from '@/components/collection/EntryList.astro';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const snippets = await getSnippets(locale);

const rows: Row[] = snippets.map((snippet) => ({
	label: snippet.data.title,
	meta: snippet.data.excerpt,
	badge: snippet.data.isNew ? '*' : undefined,
	href: getRelativeLocaleUrl(locale, `snippets/${snippet.id}`),
}));
---

<CollectionIndex
	locale={locale}
	path="snippets"
	titleKey="snippetsTitle"
	subtitleKey="snippetsSubtitle"
	length={snippets.length}
	rows={rows}
/>
