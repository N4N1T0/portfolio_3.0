---
interface Props {
	preview: string;
	tryLabel: string;
}

const { preview, tryLabel } = Astro.props;
---

<div class="border border-edge p-4">
	<p class="text-xs text-phosphor-dim">{tryLabel}</p>

	{preview === 'input-state-animation' && (
		<form id="snippet-form" class="mt-3 flex flex-col gap-3 sm:flex-row" novalidate>
			<label class="sr-only" for="snippet-input">
				email
			</label>
			<input
				id="snippet-input"
				type="text"
				name="email"
				placeholder="you@example.com"
				pattern="[^\s@]+@[^\s@]+\.[^\s@]+$"
				required
				class="w-full max-w-sm border border-edge bg-transparent px-3 py-2 text-sm text-phosphor placeholder:text-phosphor-dim/60 focus:outline-2 focus:outline-phosphor-bright aria-invalid:animate-shake-x aria-valid:animate-border-success"
			/>
			<button
				type="submit"
				class="border border-edge px-3 py-2 text-sm text-phosphor-bright transition-colors hover:bg-accent/10"
			>
				&gt;
			</button>
		</form>
	)}

	{preview === 'cover-glow' && (
		<div class="cover-glow-stage mt-3 flex justify-center py-8">
			<div class="cover-glow-art"></div>
		</div>
	)}

	{preview === 'focus-within' && (
		<div class="focus-field mt-3 border border-edge p-3">
			<label class="block text-xs text-phosphor-dim" for="focus-within-input">
				email
			</label>
			<input
				id="focus-within-input"
				type="email"
				placeholder="you@example.com"
				class="mt-1 w-full bg-transparent text-sm text-phosphor placeholder:text-phosphor-dim/60 focus:outline-none"
			/>
			<div class="focus-field-hint">
				<p class="overflow-hidden font-mono text-xs text-phosphor-dim">
					.field:focus-within &#123; ... &#125;
				</p>
			</div>
		</div>
	)}

	{preview === 'card-shine' && (
		<div class="mt-3 flex justify-center py-6">
			<button
				type="button"
				class="shine-card border border-edge bg-panel p-4 text-left font-mono focus-visible:outline-2 focus-visible:outline-phosphor-bright"
			>
				<span class="block text-xs tracking-[0.2em] text-phosphor-dim">NOIR</span>
				<span class="mt-6 block text-sm text-phosphor">•••• •••• •••• 2604</span>
				<span class="mt-1 block text-xs text-phosphor-dim">hover · focus</span>
			</button>
		</div>
	)}
</div>

<style>
	/* The glow is a pseudo-element behind the cover: no Tailwind utility sets
	   `background: inherit`, and the isolate keeps the negative z-index from
	   sinking behind the terminal window's own background. */
	.cover-glow-stage {
		isolation: isolate;
	}

	.cover-glow-art {
		position: relative;
		width: 7.5rem;
		height: 7.5rem;
		border-radius: 0.5rem;
		background: linear-gradient(135deg, #ff6b6b 0%, #4d9dff 55%, #ffd166 100%);
	}

	.cover-glow-art::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		border-radius: inherit;
		background: inherit;
		filter: blur(26px) saturate(1.8);
		scale: 1.18;
	}

	/* The parent reacts to its own child: no Tailwind variant covers
	   `:focus-within`, and `grid-template-rows: 0fr -> 1fr` is the only way to
	   animate a height nobody measured. */
	.focus-field {
		transition:
			border-color 160ms ease,
			box-shadow 160ms ease;
	}

	.focus-field:focus-within {
		border-color: var(--color-accent);
		box-shadow: 0 0 0 2px color-mix(in srgb, var(--color-accent) 35%, transparent);
	}

	.focus-field-hint {
		display: grid;
		grid-template-rows: 0fr;
		opacity: 0;
		transition:
			grid-template-rows 200ms ease,
			opacity 200ms ease;
	}

	.focus-field:focus-within .focus-field-hint {
		grid-template-rows: 1fr;
		margin-top: 0.5rem;
		opacity: 1;
	}

	/* The sweep is a pseudo-element parked outside the card: Tailwind has no
	   utility for a gradient that is mostly transparent, and the return trip
	   must jump with no transition. */
	.shine-card {
		position: relative;
		width: 17rem;
		overflow: hidden;
	}

	.shine-card::after {
		content: '';
		position: absolute;
		inset: 0;
		pointer-events: none;
		background: linear-gradient(115deg, #0000 40%, #ffffff26 50%, #0000 60%);
		translate: -100% 0;
	}

	.shine-card:hover::after,
	.shine-card:focus-visible::after {
		translate: 100% 0;
		transition: translate 800ms ease;
	}
</style>

<script>
	const form = document.querySelector<HTMLFormElement>('#snippet-form');
	const input = document.querySelector<HTMLInputElement>('#snippet-input');

	input?.addEventListener('input', () => {
		input.removeAttribute('aria-invalid');
		input.removeAttribute('aria-valid');
	});

	form?.addEventListener('submit', (event) => {
		event.preventDefault();
		if (!input) return;
		const valid = input.checkValidity();
		input.setAttribute(valid ? 'aria-valid' : 'aria-invalid', 'true');
	});
</script>
