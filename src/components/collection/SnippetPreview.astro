---
interface Props {
	preview: string;
	tryLabel: string;
}

const { preview, tryLabel } = Astro.props;
---

<div class="border border-edge p-4">
	<p class="text-xs text-phosphor-dim">{tryLabel}</p>

	{preview === 'input-state-animation' && (
		<form id="snippet-form" class="mt-3 flex flex-col gap-3 sm:flex-row" novalidate>
			<label class="sr-only" for="snippet-input">
				email
			</label>
			<input
				id="snippet-input"
				type="text"
				name="email"
				placeholder="you@example.com"
				pattern="[^\s@]+@[^\s@]+\.[^\s@]+$"
				required
				class="w-full max-w-sm border border-edge bg-transparent px-3 py-2 text-sm text-phosphor placeholder:text-phosphor-dim/60 focus:outline-2 focus:outline-phosphor-bright aria-invalid:animate-shake-x aria-valid:animate-border-success"
			/>
			<button
				type="submit"
				class="border border-edge px-3 py-2 text-sm text-phosphor-bright transition-colors hover:bg-accent/10"
			>
				&gt;
			</button>
		</form>
	)}

	{preview === 'cover-glow' && (
		<div class="cover-glow-stage mt-3 flex justify-center py-8">
			<div class="cover-glow-art"></div>
		</div>
	)}
</div>

<style>
	/* The glow is a pseudo-element behind the cover: no Tailwind utility sets
	   `background: inherit`, and the isolate keeps the negative z-index from
	   sinking behind the terminal window's own background. */
	.cover-glow-stage {
		isolation: isolate;
	}

	.cover-glow-art {
		position: relative;
		width: 7.5rem;
		height: 7.5rem;
		border-radius: 0.5rem;
		background: linear-gradient(135deg, #ff6b6b 0%, #4d9dff 55%, #ffd166 100%);
	}

	.cover-glow-art::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		border-radius: inherit;
		background: inherit;
		filter: blur(26px) saturate(1.8);
		scale: 1.18;
	}
</style>

<script>
	const form = document.querySelector<HTMLFormElement>('#snippet-form');
	const input = document.querySelector<HTMLInputElement>('#snippet-input');

	input?.addEventListener('input', () => {
		input.removeAttribute('aria-invalid');
		input.removeAttribute('aria-valid');
	});

	form?.addEventListener('submit', (event) => {
		event.preventDefault();
		if (!input) return;
		const valid = input.checkValidity();
		input.setAttribute(valid ? 'aria-valid' : 'aria-invalid', 'true');
	});
</script>
