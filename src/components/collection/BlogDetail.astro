---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

interface Props {
	post: CollectionEntry<'blog'>;
	publishedLabel: string;
	updatedLabel: string;
	relatedLabel: string;
	related: Array<{ title: string; href: string; excerpt: string }>;
	locale: string;
}

const { post, publishedLabel, updatedLabel, relatedLabel, related, locale } = Astro.props;
const { Content } = await render(post);
const formatDate = (date: Date) => date.toLocaleDateString(locale, { dateStyle: 'long' });
---

<article class="font-mono">
	<header>
		<h1 class="text-phosphor-bright text-xl sm:text-2xl">{post.data.title}</h1>
		<p class="mt-2 text-sm text-phosphor-dim">
			<time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>·{' '}
			{post.data.author} · {publishedLabel}
		</p>
		{post.data.dateModified && (
			<p class="text-sm text-phosphor-dim">
				<time datetime={post.data.dateModified.toISOString()}>
					{formatDate(post.data.dateModified)}
				</time>
				· {updatedLabel}
			</p>
		)}
	</header>

	<p class="mt-4 max-w-2xl text-sm leading-relaxed text-phosphor">{post.data.excerpt}</p>
	<div class="prose prose-invert prose-terminal mt-6 max-w-2xl">
		<Content />
	</div>

	{related.length > 0 && (
		<nav class="mt-10 max-w-2xl text-sm" aria-label={relatedLabel}>
			<h2 class="text-phosphor-dim text-xs uppercase tracking-widest">{relatedLabel}</h2>
			<ul class="mt-3 divide-y divide-edge border-y border-edge">
				{related.map((entry) => (
					<li>
						<a href={entry.href} class="group block px-1 py-2 hover:bg-accent/10">
							<span class="text-accent group-hover:underline">{entry.title}</span>
							<span class="mt-0.5 block text-phosphor-dim">{entry.excerpt}</span>
						</a>
					</li>
				))}
			</ul>
		</nav>
	)}
</article>
