---
import { getRelativeLocaleUrl } from 'astro:i18n';
import BackRow from '@/components/collection/BackRow.astro';
import ProjectDetail from '@/components/collection/ProjectDetail.astro';
import TerminalWindow from '@/components/TerminalWindow.astro';
import { copy, type Locale } from '@/data/copy';
import TerminalLayout from '@/layouts/TerminalLayout.astro';
import { getProject } from '@/lib/content';

interface Props {
	locale: Locale;
	id: string;
}

const { locale, id } = Astro.props;
const t = copy[locale];
const alt: Locale = locale === 'en' ? 'es' : 'en';
const project = await getProject(locale, id);
---

<TerminalLayout
	locale={locale}
	title={project ? `${project.data.title} — Adrián Álvarez` : 'Not found'}
	description={project?.data.excerpt ?? t.collections.projectsSubtitle}
	ogAlt={project?.data.title ?? t.collections.projectsTitle}
>
	<div class="mx-auto w-full max-w-4xl px-4 py-6 sm:px-6">
		<TerminalWindow path={`~/projects/${id}`}>
			{project ? (
				<ProjectDetail project={project} labels={t.collections} />
			) : (
				<p class="text-sm text-phosphor-dim">404 · not found</p>
			)}
			<div class="mt-6">
				<BackRow
					backHref={getRelativeLocaleUrl(locale, 'projects')}
					backLabel={t.collections.back}
					altLocale={{ label: alt, href: getRelativeLocaleUrl(alt, `projects/${id}`) }}
					language={t.language}
				/>
			</div>
		</TerminalWindow>
	</div>
</TerminalLayout>
