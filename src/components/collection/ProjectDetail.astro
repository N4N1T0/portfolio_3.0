---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

type Labels = {
	live: string;
	stack: string;
	challenge: string;
	solution: string;
};

interface Props {
	project: CollectionEntry<'projects'>;
	labels: Labels;
}

const { project, labels } = Astro.props;
const { data } = project;

// shortcut: markdown mínimo (párrafos, listas "- ", saltos de línea y enlaces [texto](url)).
// Techo: sin encabezados, negritas ni código. Ruta: un parser markdown si el copy lo pide.
const escapeHtml = (text: string) =>
	text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const inline = (line: string) =>
	escapeHtml(line).replace(
		/\[([^\]]+)\]\((https?:\/\/[^)\s]+)\)/g,
		'<a href="$2" target="_blank" rel="noopener noreferrer" class="text-phosphor-bright underline underline-offset-4">$1</a>',
	);
const toHtml = (text: string) =>
	text
		.split(/\n{2,}/)
		.map((block) => {
			const lines = block.split('\n');
			if (lines.every((line) => line.startsWith('- '))) {
				return `<ul class="list-disc pl-5">${lines.map((line) => `<li>${inline(line.slice(2))}</li>`).join('')}</ul>`;
			}
			return `<p>${lines.map((line) => inline(line)).join('<br>')}</p>`;
		})
		.join('');
---

<article class="font-mono">
	<header class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
		<h1 class="text-phosphor-bright text-xl sm:text-2xl">{data.title}</h1>
		<time datetime={data.date} class="text-sm text-phosphor-dim">
			{data.date}
		</time>
		{data.liveLink && (
			<a
				href={data.liveLink}
				target="_blank"
				rel="noopener noreferrer"
				class="text-sm text-phosphor-bright underline underline-offset-4"
			>
				{labels.live} ↗
			</a>
		)}
	</header>

	<p class="mt-3 max-w-2xl text-sm leading-relaxed text-phosphor">{data.excerpt}</p>

	{data.images.map((image) =>
		image.src ? (
			<figure class="mt-5 max-w-2xl border border-edge">
				<Image
					src={image.src}
					alt={image.alt}
					width={image.src.width}
					height={image.src.height}
					widths={[400, 800, 1200]}
					sizes="(max-width: 896px) 100vw, 672px"
					loading="lazy"
					decoding="async"
					class="w-full"
				/>
				<figcaption class="border-t border-edge px-3 py-1.5 text-xs text-phosphor-dim">
					{image.alt}
				</figcaption>
			</figure>
		) : null,
	)}

	{data.challenge && (
		<section class="mt-6">
			<h2 class="text-accent">{labels.challenge}</h2>
			<div
				class="mt-1 max-w-2xl space-y-2 text-sm leading-relaxed"
				set:html={toHtml(data.challenge)}
			/>
		</section>
	)}

	{data.solution && (
		<section class="mt-6">
			<h2 class="text-accent">{labels.solution}</h2>
			<div
				class="mt-1 max-w-2xl space-y-2 text-sm leading-relaxed"
				set:html={toHtml(data.solution)}
			/>
		</section>
	)}

	<section class="mt-6">
		<h2 class="text-accent">{labels.stack}</h2>
		<ul class="mt-2 flex flex-wrap gap-2">
			{data.techStack.map((tech) => (
				<li class="border border-edge px-2 py-0.5 text-xs text-phosphor-dim">
					<a
						href={tech.link}
						target="_blank"
						rel="noopener noreferrer"
						class="hover:text-phosphor-bright"
					>
						{tech.title}
					</a>
				</li>
			))}
		</ul>
	</section>
</article>
