---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { type Locale } from '@/data/copy';
import { getPosts } from '@/lib/content';
import CollectionIndex from '@/components/collection/CollectionIndex.astro';
import { type Row } from '@/components/collection/EntryList.astro';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const posts = await getPosts(locale);

const rows: Row[] = posts.map((post) => ({
	label: post.data.title,
	meta: post.data.excerpt,
	badge: post.data.date.toLocaleDateString(locale, { year: 'numeric', month: '2-digit' }),
	href: getRelativeLocaleUrl(locale, `blog/${post.id}`),
}));
---

<CollectionIndex
	locale={locale}
	path="blog"
	titleKey="blogTitle"
	subtitleKey="blogSubtitle"
	length={posts.length}
	rows={rows}
/>
