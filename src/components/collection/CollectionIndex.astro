---
import { getRelativeLocaleUrl } from 'astro:i18n';
import BackRow from '@/components/collection/BackRow.astro';
import EntryList, { type Row } from '@/components/collection/EntryList.astro';
import TerminalWindow from '@/components/TerminalWindow.astro';
import NumericNavSetter from '@/components/collection/NumericNavSetter.islas.tsx';
import { copy, type Copy, type Locale } from '@/data/copy';
import TerminalLayout from '@/layouts/TerminalLayout.astro';

interface Props {
	locale: Locale;
	path: string;
	titleKey: keyof Copy['collections'];
	subtitleKey: keyof Copy['collections'];
	length: number;
	rows: Row[];
	note?: string;
}

const { locale, path, titleKey, subtitleKey, length, rows, note } = Astro.props;
const t = copy[locale];
const alt: Locale = locale === 'en' ? 'es' : 'en';

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const breadcrumbs = [
	{ name: t.collections.back, href: getRelativeLocaleUrl(locale) },
	{ name: t.collections[titleKey], href: canonical },
];

const numericEntries = rows.map((row, index) => ({
	number: index + 1,
	label: row.label,
	href: row.href,
}));
---

<TerminalLayout
	locale={locale}
	title={`${t.collections[titleKey]} — Adrián Álvarez`}
	description={t.collections[subtitleKey]}
	ogAlt={`${t.collections[titleKey]} — Adrián Álvarez`}
	breadcrumbs={breadcrumbs}
>
	<div class="mx-auto w-full max-w-4xl px-4 py-6 sm:px-6">
		<TerminalWindow path={`~/${path}`}>
			<h1 class="text-phosphor-bright text-xl">{t.collections[titleKey]}</h1>
			<p class="mt-1 max-w-2xl text-sm text-phosphor-dim">{t.collections[subtitleKey]}</p>
			<p class="mt-3 text-xs text-phosphor-dim">
				{length} {t.collections.entries}
			</p>
			<div class="mt-4">
				<EntryList rows={rows} />
			</div>
			{note && (
				<p
					data-collection-note
					class="mt-4 max-w-2xl border-t border-edge pt-3 font-mono text-xs leading-relaxed text-phosphor-dim"
				>
					<span data-text>{note}</span>
					<span data-cursor class="terminal-cursor" aria-hidden="true" hidden></span>
				</p>
			)}
			<div class="mt-4">
				<BackRow
					backHref={getRelativeLocaleUrl(locale)}
					backLabel={t.collections.back}
					altLocale={{ label: alt, href: getRelativeLocaleUrl(alt) }}
					language={t.language}
				/>
			</div>
		</TerminalWindow>
	</div>
</TerminalLayout>

<NumericNavSetter client:load entries={numericEntries} />

<script>
	import { typeLine } from '@/lib/terminal-typing';

	const note = document.querySelector<HTMLElement>('[data-collection-note]');
	if (note && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
		const text = note.querySelector('[data-text]')?.textContent ?? '';
		typeLine(note, [{ type: 'type', text }], 12);
	}
</script>
