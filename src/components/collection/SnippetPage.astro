---
import { getRelativeLocaleUrl } from 'astro:i18n';
import BackRow from '@/components/collection/BackRow.astro';
import SnippetDetail from '@/components/collection/SnippetDetail.astro';
import TerminalWindow from '@/components/TerminalWindow.astro';
import { copy, type Locale } from '@/data/copy';
import TerminalLayout from '@/layouts/TerminalLayout.astro';
import { getSnippet } from '@/lib/content';

interface Props {
	locale: Locale;
	id: string;
}

const { locale, id } = Astro.props;
const t = copy[locale];
const alt: Locale = locale === 'en' ? 'es' : 'en';
const snippet = await getSnippet(locale, id);

// Find counterpart for alternate language link
const counterpart = snippet
	? await getSnippet(alt, snippet.data.counterpartId?.replace(`${alt}/`, '') ?? '')
	: undefined;
const counterpartSlug = counterpart?.id.replace(`${alt}/`, '');
const altHref = getRelativeLocaleUrl(
	alt,
	counterpartSlug ? `snippets/${counterpartSlug}` : 'snippets',
);

const canonical = new URL(Astro.url.pathname, Astro.site).href;

// Infer programming language from preview (these are CSS-focused snippets)
const programmingLanguage = snippet?.data.preview
	? [
			'focus-within',
			'cover-glow',
			'card-shine',
			'gradient-grain',
			'split-button',
			'fab-menu',
		].includes(snippet.data.preview)
		? 'CSS'
		: 'JavaScript'
	: 'CSS';

const breadcrumbs = snippet
	? [
			{ name: t.collections.home, href: getRelativeLocaleUrl(locale) },
			{ name: t.collections.snippetsTitle, href: getRelativeLocaleUrl(locale, 'snippets') },
			{ name: snippet.data.title, href: canonical },
		]
	: undefined;

const codeSnippet = snippet
	? {
			title: snippet.data.title,
			description: snippet.data.excerpt,
			programmingLanguage,
			author: 'Adrián Álvarez',
			url: canonical,
		}
	: undefined;
---

<TerminalLayout
	locale={locale}
	title={snippet ? `${snippet.data.title} — Adrián Álvarez` : 'Not found'}
	description={snippet?.data.excerpt ?? t.collections.snippetsSubtitle}
	ogAlt={snippet?.data.title ?? t.collections.snippetsTitle}
	alternateHref={altHref}
	alternateLang={alt}
	breadcrumbs={breadcrumbs}
	codeSnippet={codeSnippet}
>
	<div class="mx-auto w-full max-w-4xl px-4 py-6 sm:px-6">
		<TerminalWindow path={`~/snippets/${id}`}>
			{snippet ? (
				<SnippetDetail snippet={snippet} tryLabel={t.collections.try} />
			) : (
				<p class="text-sm text-phosphor-dim">404 · not found</p>
			)}
			<div class="mt-6">
				<BackRow
					backHref={getRelativeLocaleUrl(locale, 'snippets')}
					backLabel={t.collections.back}
					altLocale={{ label: alt, href: getRelativeLocaleUrl(alt, `snippets/${id}`) }}
					language={t.language}
				/>
			</div>
		</TerminalWindow>
	</div>
</TerminalLayout>
