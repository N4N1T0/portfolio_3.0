{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"framework": "astro",
	"buildCommand": "pnpm run build",
	"installCommand": "pnpm install --frozen-lockfile",
	"redirects": [
		{
			"source": "/",
			"destination": "/en/",
			"permanent": true
		},
		{
			"source": "/es/blog/usando-notion-para-mejorar-tus-royectos",
			"destination": "/es/blog/usando-notion-para-mejorar-tus-proyectos/",
			"permanent": true
		},
		{
			"source": "/es/blog/usando-notion-para-mejorar-tus-royectos/",
			"destination": "/es/blog/usando-notion-para-mejorar-tus-proyectos/",
			"permanent": true
		},
		{
			"source": "/es/blog/introducion-a-redsys-en-nextjs-15",
			"destination": "/es/blog/introduccion-a-redsys-en-nextjs-15/",
			"permanent": true
		},
		{
			"source": "/es/blog/introducion-a-redsys-en-nextjs-15/",
			"destination": "/es/blog/introduccion-a-redsys-en-nextjs-15/",
			"permanent": true
		},
		{
			"source": "/es/blog/introducion-a-redsys-en-nextjs-15-parte-2",
			"destination": "/es/blog/introduccion-a-redsys-en-nextjs-15-parte-2/",
			"permanent": true
		},
		{
			"source": "/es/blog/introducion-a-redsys-en-nextjs-15-parte-2/",
			"destination": "/es/blog/introduccion-a-redsys-en-nextjs-15-parte-2/",
			"permanent": true
		}
	],
	"headers": [
		{
			"source": "/(.*)",
			"headers": [
				{ "key": "X-Content-Type-Options", "value": "nosniff" },
				{ "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
				{ "key": "X-Frame-Options", "value": "SAMEORIGIN" },
				{
					"key": "Strict-Transport-Security",
					"value": "max-age=63072000; includeSubDomains; preload"
				},
				{
					"key": "Permissions-Policy",
					"value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
				}
			]
		},
		{
			"source": "/_astro/(.*)",
			"headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
		},
		{
			"source": "/og.png",
			"headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
		}
	]
}
