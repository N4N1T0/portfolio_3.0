{
	"$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
	// build-time frameworks: imported by astro.config.mjs, never by app code
	"ignoreDependencies": ["astro", "@astrojs/preact"],
	"rules": {
		// @resvg/resvg-js and wawoff2 render the OG image at build time and
		// @tailwindcss/typography is a Tailwind plugin: none of them ship
		"dev-dependencies-in-production": "off"
	},
	"health": {
		// CRAP is estimated from export references, and this repo has no test
		// runner, so the coverage term is always zero and every branch counts as
		// untested. These two files are a 34-line boot timeline and a list
		// renderer: their cyclomatic and cognitive scores are low.
		"ignore": [
			"src/components/useTerminalSequence.ts",
			"src/components/CommandList.tsx",
			"src/components/useTerminalCommands.ts",
			"src/components/ShellPrompt.tsx",
			"src/lib/terminal-typing.ts"
		]
	}
}
